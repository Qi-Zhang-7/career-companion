# Copy this file to .env and replace YOUR_PASSWORD locally.
# Never commit the real password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/career_companion?schema=public"

# Add this only when the real model integration phase begins.
# Keep the real key in .env or the hosting platform's secret manager, never in Git.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
