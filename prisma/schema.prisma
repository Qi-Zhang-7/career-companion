generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConfirmationStatus {
  AUTO_RECORDED
  PENDING_EVIDENCE
  PENDING_CONFIRMATION
  USER_CONFIRMED
  USER_CORRECTED
  USER_REJECTED
  SUPERSEDED
}

enum EvidenceKind {
  FACT
  OBSERVATION
  INFERENCE
  USER_FEELING
  COMMUNICATION_PREFERENCE
  EFFECTIVE_STRATEGY
}

enum GrowthThemeStatus {
  EMERGING
  PENDING_CONFIRMATION
  ACTIVE
  IMPROVING
  DORMANT
  RESOLVED
  REJECTED
}

enum GrowthThemeSource {
  USER_CREATED
  AI_SUGGESTED
  CO_CREATED
  REFLECTION_DERIVED
}

enum ConversationMode {
  LISTENING
  COACHING
  ADVICE
  ROLEPLAY
  REFLECTION
  CAREER
  SAFETY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ReportStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String?            @unique
  displayName       String
  locale            String             @default("zh-CN")
  timezone          String             @default("Asia/Shanghai")
  memoryEnabled     Boolean            @default(true)
  consentVersion    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  careerProfile     CareerProfile?
  careerGoals       CareerGoal[]
  growthThemes      GrowthTheme[]
  people            Person[]
  relationships     Relationship[]
  conversations     Conversation[]
  workEvents        WorkEvent[]
  actionItems       ActionItem[]
  reflections       Reflection[]
  roleplaySessions  RoleplaySession[]
  memories          Memory[]
  insights          UserInsight[]
  patterns          UserPattern[]
  selfModelEntries  SelfModelEntry[]
  worldModelEntries WorldModelEntry[]
  interactionModels InteractionModel[]
  growthReports     GrowthReport[]
}

model CareerProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  currentRole          String?
  industry             String?
  companyType          String?
  companyAlias         String?
  city                 String?
  yearsExperience      Int?
  salaryRangeEncrypted String?
  teamName             String?
  teamSize             Int?
  managerTitle         String?
  careerStage          String?
  profileCompleteness  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerGoal {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  horizon     String
  title       String
  description String?
  status      String    @default("ACTIVE")
  targetDate  DateTime?
  confidence  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model GrowthTheme {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  title              String
  description        String?             @db.Text
  status             GrowthThemeStatus   @default(EMERGING)
  source             GrowthThemeSource
  originSummary      String?             @db.Text
  confidence         Float?
  confirmationStatus ConfirmationStatus  @default(PENDING_CONFIRMATION)
  firstSeenAt        DateTime            @default(now())
  lastSeenAt         DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  links              GrowthThemeLink[]
  reportThemes       GrowthReportTheme[]

  @@index([userId, status, lastSeenAt(sort: Desc)])
}

model GrowthThemeLink {
  id             String      @id @default(uuid()) @db.Uuid
  growthThemeId  String      @db.Uuid
  entityType     String
  entityId       String      @db.Uuid
  relationType   String
  evidenceWeight Float?
  createdAt      DateTime    @default(now())
  growthTheme    GrowthTheme @relation(fields: [growthThemeId], references: [id], onDelete: Cascade)

  @@unique([growthThemeId, entityType, entityId, relationType])
  @@index([entityType, entityId])
}

model Person {
  id                      String                  @id @default(uuid()) @db.Uuid
  userId                  String                  @db.Uuid
  displayName             String
  roleTitle               String?
  groupType               String?
  organizationAlias       String?
  notes                   String?                 @db.Text
  sensitivityLevel        String                  @default("NORMAL")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationships           Relationship[]
  observations            PersonObservation[]
  communicationStrategies CommunicationStrategy[]
  workEventPeople         WorkEventPerson[]
  roleplaySessions        RoleplaySession[]
  interactionModels       InteractionModel[]

  @@index([userId, displayName])
}

model Relationship {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  personId             String   @db.Uuid
  relationshipType     String
  closeness            Int?
  influenceLevel       Int?
  communicationSummary String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person               Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId, relationshipType])
}

model PersonObservation {
  id                   String             @id @default(uuid()) @db.Uuid
  personId             String             @db.Uuid
  kind                 EvidenceKind
  content              String             @db.Text
  confidence           Float?
  confirmationStatus   ConfirmationStatus @default(PENDING_EVIDENCE)
  sourceType           String
  sourceId             String?            @db.Uuid
  evidenceCount        Int                @default(1)
  counterEvidenceCount Int                @default(0)
  validFrom            DateTime?
  validTo              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  person               Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, kind, confirmationStatus])
}

model CommunicationStrategy {
  id            String   @id @default(uuid()) @db.Uuid
  personId      String   @db.Uuid
  context       String   @db.Text
  strategy      String   @db.Text
  evidenceCount Int      @default(0)
  effectiveness Float?
  status        String   @default("CANDIDATE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @db.Uuid
  mode      ConversationMode
  title     String?
  status    EntityStatus          @default(ACTIVE)
  summary   String?               @db.Text
  startedAt DateTime              @default(now())
  endedAt   DateTime?
  deletedAt DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]

  @@index([userId, deletedAt, startedAt(sort: Desc)])
}

model ConversationMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  role           MessageRole
  content        String            @db.Text
  mode           ConversationMode?
  model          String?
  promptVersion  String?
  tokenUsage     Json?
  safetyLevel    String?
  sequenceNo     Int
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memoryEvidence MemoryEvidence[]

  @@unique([conversationId, sequenceNo])
  @@index([conversationId, createdAt])
}

model WorkEvent {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @db.Uuid
  title              String
  occurredAt         DateTime
  eventType          String
  facts              String            @db.Text
  userInterpretation String?           @db.Text
  emotion            String?
  concern            String?           @db.Text
  outcome            String?           @db.Text
  importance         Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dynamics           EventDynamics?
  people             WorkEventPerson[]
  reflections        Reflection[]

  @@index([userId, occurredAt(sort: Desc)])
}

model EventDynamics {
  id                String    @id @default(uuid()) @db.Uuid
  workEventId       String    @unique @db.Uuid
  triggerType       String?
  perceivedPressure String?
  userNeed          String?
  userResponse      String?   @db.Text
  otherResponse     String?   @db.Text
  outcomeCode       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workEvent         WorkEvent @relation(fields: [workEventId], references: [id], onDelete: Cascade)
}

model WorkEventPerson {
  workEventId String    @db.Uuid
  personId    String    @db.Uuid
  roleInEvent String?
  workEvent   WorkEvent @relation(fields: [workEventId], references: [id], onDelete: Cascade)
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([workEventId, personId])
}

model ActionItem {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  sourceType  String?
  sourceId    String?      @db.Uuid
  description String       @db.Text
  dueAt       DateTime?
  status      ActionStatus @default(OPEN)
  resultNote  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

model Reflection {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  workEventId    String?    @db.Uuid
  goalSelf       String?    @db.Text
  goalOther      String?    @db.Text
  whatHappened   String     @db.Text
  workedWell     String?    @db.Text
  improvements   String?    @db.Text
  nextExperiment String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workEvent      WorkEvent? @relation(fields: [workEventId], references: [id], onDelete: SetNull)
}

model RoleplaySession {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  personId     String?           @db.Uuid
  roleTemplate String
  scenario     String            @db.Text
  personaStyle String?
  difficulty   String
  userGoal     String            @db.Text
  status       EntityStatus      @default(ACTIVE)
  reviewJson   Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  person       Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  messages     RoleplayMessage[]
}

model RoleplayMessage {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String          @db.Uuid
  role         MessageRole
  content      String          @db.Text
  sequenceNo   Int
  feedbackTags Json?
  createdAt    DateTime        @default(now())
  session      RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequenceNo])
}

model Memory {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  type               String
  canonicalText      String             @db.Text
  structuredData     Json?
  certainty          String
  confidence         Float?
  importance         Int                @default(1)
  sensitivity        String             @default("NORMAL")
  confirmationStatus ConfirmationStatus @default(PENDING_CONFIRMATION)
  validFrom          DateTime?
  validTo            DateTime?
  status             EntityStatus       @default(ACTIVE)
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence           MemoryEvidence[]
  links              MemoryLink[]

  @@index([userId, type, status])
}

model MemoryEvidence {
  id             String               @id @default(uuid()) @db.Uuid
  memoryId       String               @db.Uuid
  messageId      String?              @db.Uuid
  sourceType     String
  sourceId       String               @db.Uuid
  excerptHash    String?
  evidenceWeight Float?
  createdAt      DateTime             @default(now())
  memory         Memory               @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  message        ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([memoryId, sourceType, sourceId])
}

model MemoryLink {
  id           String @id @default(uuid()) @db.Uuid
  memoryId     String @db.Uuid
  entityType   String
  entityId     String @db.Uuid
  relationType String
  memory       Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model UserInsight {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  type               String
  title              String
  summary            String             @db.Text
  confidence         Float?
  confirmationStatus ConfirmationStatus @default(PENDING_CONFIRMATION)
  firstSeenAt        DateTime           @default(now())
  lastSeenAt         DateTime           @default(now())
  status             EntityStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence           InsightEvidence[]
}

model InsightEvidence {
  id           String      @id @default(uuid()) @db.Uuid
  insightId    String      @db.Uuid
  sourceType   String
  sourceId     String      @db.Uuid
  evidenceNote String      @db.Text
  weight       Float?
  occurredAt   DateTime?
  insight      UserInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
}

model UserPattern {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  triggerSignature    Json
  responseSignature   Json
  outcomeSignature    Json?
  confidence          Float?
  eventCount          Int                @default(0)
  counterexampleCount Int                @default(0)
  confirmationStatus  ConfirmationStatus @default(PENDING_EVIDENCE)
  status              String             @default("CANDIDATE")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, confidence])
}

model SelfModelEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  category           String
  statement          String             @db.Text
  certainty          String
  confidence         Float?
  evidenceCount      Int                @default(0)
  confirmationStatus ConfirmationStatus @default(PENDING_EVIDENCE)
  validFrom          DateTime?
  validTo            DateTime?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model WorldModelEntry {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  entityType    String
  entityId      String?   @db.Uuid
  statement     String    @db.Text
  certainty     String
  confidence    Float?
  evidenceCount Int       @default(0)
  validFrom     DateTime?
  validTo       DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType])
}

model InteractionModel {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @db.Uuid
  personId                String?               @db.Uuid
  environmentType         String?
  triggerSignature        Json
  typicalInternalResponse String?               @db.Text
  typicalBehavior         String?               @db.Text
  typicalOutcome          String?               @db.Text
  effectiveStrategy       String?               @db.Text
  confidence              Float?
  status                  String                @default("CANDIDATE")
  version                 Int                   @default(1)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  person                  Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  evidence                InteractionEvidence[]

  @@index([userId, personId, environmentType, status])
}

model InteractionEvidence {
  id                 String           @id @default(uuid()) @db.Uuid
  interactionModelId String           @db.Uuid
  sourceType         String
  sourceId           String           @db.Uuid
  observedChange     String?          @db.Text
  evidenceWeight     Float?
  occurredAt         DateTime?
  interactionModel   InteractionModel @relation(fields: [interactionModelId], references: [id], onDelete: Cascade)

  @@unique([interactionModelId, sourceType, sourceId])
}

model GrowthReport {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String                 @db.Uuid
  periodType        ReportPeriod
  periodStart       DateTime
  periodEnd         DateTime
  status            ReportStatus           @default(DRAFT)
  summarySnapshot   String                 @db.Text
  nextFocusSnapshot String?                @db.Text
  generatedAt       DateTime               @default(now())
  confirmedAt       DateTime?
  version           Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  themes            GrowthReportTheme[]
  evidence          GrowthReportEvidence[]

  @@unique([userId, periodType, periodStart, periodEnd, version])
  @@index([userId, periodStart(sort: Desc)])
}

model GrowthReportTheme {
  id                        String                 @id @default(uuid()) @db.Uuid
  reportId                  String                 @db.Uuid
  growthThemeId             String?                @db.Uuid
  themeTitleSnapshot        String
  themeStatusSnapshot       String
  pastPatternSnapshot       String?                @db.Text
  recentPatternSnapshot     String?                @db.Text
  effectiveStrategySnapshot String?                @db.Text
  nextExperimentSnapshot    String?                @db.Text
  report                    GrowthReport           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  growthTheme               GrowthTheme?           @relation(fields: [growthThemeId], references: [id], onDelete: SetNull)
  evidence                  GrowthReportEvidence[]
}

model GrowthReportEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  reportId         String             @db.Uuid
  reportThemeId    String?            @db.Uuid
  sourceType       String
  sourceId         String             @db.Uuid
  evidenceSnapshot String             @db.Text
  occurredAt       DateTime
  report           GrowthReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportTheme      GrowthReportTheme? @relation(fields: [reportThemeId], references: [id], onDelete: Cascade)

  @@index([reportId, occurredAt])
}
